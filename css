/* Reset & Base Styles */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
  color: #222222;
  background-color: #f4f6f8;
}

/* Navigation Bar */
header {
  background-color: #1e293b;
  padding: 1rem 2rem;
  position: sticky;
  top: 0;
}

nav {
  max-width: 1000px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}

.logo {
  color: #ffffff;
  font-size: 1.3rem;
  font-weight: bold;
  text-decoration: none;
}

.nav-links {
  list-style: none;
  display: flex;
  gap: 1.5rem;
}

.nav-links a {
  color: #cbd5e1;
  text-decoration: none;
  font-weight: bold;
  transition: color 0.3s ease;
}

.nav-links a:hover,
.nav-links a.active {
  color: #38bdf8;
}

/* Main Container */
main {
  max-width: 1000px;
  margin: 2rem auto;
  padding: 0 1.5rem;
}

/* Hero Section (Home) */
.hero {
  background-color: #ffffff;
  padding: 3rem 2rem;
  border-radius: 10px;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.profile-pic {
  width: 150px;
  height: 150px;
  object-fit: cover;
  border-radius: 50%;
  border: 4px solid #38bdf8;
  margin-bottom: 1rem;
}

.hero h1 {
  font-size: 2rem;
  margin-bottom: 0.5rem;
  color: #0f172a;
}

.hero p {
  color: #475569;
  max-width: 600px;
  margin: 0 auto 1.5rem auto;
}

.btn {
  display: inline-block;
  background-color: #0284c7;
  color: #ffffff;
  padding: 0.75rem 1.5rem;
  text-decoration: none;
  border-radius: 6px;
  font-weight: bold;
  transition: background-color 0.3s ease;
}

.btn:hover {
  background-color: #0369a1;
}

/* Cards & Grid (About & Gallery) */
.section-title {
  margin-bottom: 1.5rem;
  color: #0f172a;
  border-left: 5px solid #0284c7;
  padding-left: 0.75rem;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem;
}

.card {
  background-color: #ffffff;
  padding: 1.5rem;
  border-radius: 10px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease;
}

.card:hover {
  transform: translateY(-5px);
}

.card img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  border-radius: 6px;
  margin-bottom: 1rem;
}

.card h3 {
  margin-bottom: 0.5rem;
  color: #0f172a;
}

/* Footer */
footer {
  text-align: center;
  padding: 1.5rem;
  margin-top: 3rem;
  background-color: #1e293b;
  color: #cbd5e1;
  font-size: 0.9rem;
}

/* Mobile Adjustments */
@media (max-width: 600px) {
  nav {
    flex-direction: column;
    gap: 0.75rem;
  }
}
